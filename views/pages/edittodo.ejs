<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Todo</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<style>
    body {
background: linear-gradient(135deg, #3b3f5c, #0d0d0e);
 }
    /* Edit Button (Yellow) */
.btn-edit {
    background: #736dc4;        /* Light lavender purple */
    color: #fff;
    padding: 6px 20px;
    border-radius: 25px;
    border: none;
    font-weight: 500;
    transition: 0.2s;
}
.btn-edit:hover {
    background: #7a6ceb;
}
.btn-delete {
    background: #7d44ae;        /* Coral pink */
    color: #fff;
    padding: 6px 20px;
    border-radius: 25px;
    border: none;
    font-weight: 500;
    transition: 0.2s;
}

.btn-delete:hover {
    background: #e85a70;
}
a {
    text-decoration: none;
}


    .todo-card {
        background-color: rgba(255,255,255,0.05);
        backdrop-filter: blur(5px);
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        padding: 1.5rem;
        transition: transform 0.2s;
    }
    .todo-card:hover { transform: scale(1.02); }
    .list-group-item {
        background-color: rgba(255,255,255,0.1);
        border: none;
        margin-bottom: 0.5rem;
        border-radius: 8px;
        transition: background 0.2s;
        color: white;
    }
    .list-group-item:hover { background-color: rgba(255,255,255,0.2); }
    .btn-custom { border-radius: 50px; }
</style>
</head>
<body>
<div class="container py-5">
    <h1 class="text-center text-white mb-5">Edit Todo</h1>
    <div class="todo-card mx-auto" style="max-width: 500px;">
        <form action="/edit/<%= id %>" method="POST">
            <div class="mb-3">
                <input type="text" name="title" placeholder="Title" class="form-control" value="<%= todo.title %>" required>
            </div>
            <div class="mb-3">
                <input type="text" name="description" placeholder="Description" class="form-control" value="<%= todo.description %>" required>
            </div>
            <div class="mb-3">
                <input type="text" name="category" placeholder="Category" class="form-control" value="<%= todo.category %>" required>
            </div>
            <div class="mb-3">
                <select name="status" class="form-control" required>
                    <option value="Pending" <%= todo.status==='Pending'?'selected':'' %>>Pending</option>
                    <option value="In Progress" <%= todo.status==='In Progress'?'selected':'' %>>In Progress</option>
                    <option value="Completed" <%= todo.status==='Completed'?'selected':'' %>>Completed</option>
                </select>
            </div>
            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-warning btn-custom">Update Todo</button>
                <a href="/" class="btn btn-secondary btn-custom">Back to List</a>
            </div>
        </form>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
