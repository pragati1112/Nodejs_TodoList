<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Add Todo</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
</head>
<style>
    body {
        background: linear-gradient(135deg, #1f1c2c, #928dab);
        min-height: 100vh;
    }
    .todo-card {
        background-color: rgba(255,255,255,0.05);
        backdrop-filter: blur(5px);
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.4);
        padding: 1.5rem;
        transition: transform 0.2s;
    }
   a {
    text-decoration: none;
}
    .btn-addtodo{
    background-color: #472d5e;
    padding: 10px;
    border-radius: 5px;
    border: 1px solid black;
    color: #fff;
    font-weight: 400;
    font-size: large;
    font-family: cursive;
}
    .todo-card:hover { transform: scale(1.02); }
    .list-group-item {
        background-color: rgba(255,255,255,0.1);
        border: none;
        margin-bottom: 0.5rem;
        border-radius: 8px;
        transition: background 0.2s;
        color: white;
    }
    .my{
        padding: 10px ;
        border-radius: 5px;
        background-color: #504d62;
        color: #ffffff;
        font-family: cursive;
        border: 1px solid black;
    }
    .list-group-item:hover { background-color: rgba(255,255,255,0.2); }
    .btn-custom { border-radius: 50px; }
</style>

<body>
<div class="container py-5">
    <h1 class="text-center text-white mb-5">Add New Todo</h1>
    <div class="todo-card mx-auto" style="max-width: 500px;">
        <form action="/add" method="POST">
            <div class="mb-3">
                <input type="text" name="title" placeholder="Title" class="form-control" required>
            </div>
            <div class="mb-3">
                <input type="text" name="description" placeholder="Description" class="form-control" required>
            </div>
            <div class="mb-3">
                <input type="text" name="category" placeholder="Category" class="form-control" required>
            </div>
            <div class="mb-3">
                <select name="status" class="form-control" required>
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
            <div class="d-flex justify-content-between">
                <button type="submit" class=" my">Add Todo</button>
                <a href="/" class="btn-addtodo">Back to List</a>
            </div>
        </form>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
